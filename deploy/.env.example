# Скопируйте в .env и задайте реальные значения.

# --- Общий Postgres (агенты + keycloak) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Keycloak ---
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change-me-admin

# Белый IP сервера (без http://). Подставляется в redirect URIs / web origins
# realm при импорте (см. keycloak/tidi-realm.json).
PUBLIC_IP=203.0.113.7
